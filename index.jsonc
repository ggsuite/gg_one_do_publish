{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "gg_one_do_publish",

  // 1-2 sentence summary about this repo.
  "summary": "Publish orchestrator of the gg_one tool family: version bump, changelog, registry upload, merge, tags, resume.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "do publish / can publish of a single repo; --continue, --restart, --merge-only",
    "dependency upgrade + bookkeeping commit before can publish (respects gg_rc.jsonc)",
    "wait until visible on pub.dev / npm",
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "gg_one_core": "GgState, GgSystemCommit, publish config, GgRc",
      "gg_one_commit": "CanCommit, DidCommit, DoPush, DoUpgradeDeps",
      "gg_one_merge": "merge into the default branch",
      "gg_publish": "registry upload, WaitUntilPublished",
      "gg_changelog": "CHANGELOG release section",
      "gg_version": "version bump",
      "gg_git": "git state and tags",
      "gg_merge": "pull request merge",
      "gg_lang": "project type",
      "gg_process": "GgProcessWrapper",
      "gg_args": "command base",
      "gg_status_printer": "progress output",
      "gg_console_colors": "colored output",
      "gg_log": "GgLog",
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "gg_one": "registers do publish",
      "gg_multi_do_publish": "publishes each ticket repo",
    },
  },
}
